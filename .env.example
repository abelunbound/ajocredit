# ============================================================================
# AjoFinance Environment Configuration
# ============================================================================
#
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the `.env` file to version control - it contains secrets!
#
# The `.env` file is loaded automatically by many tools (python-dotenv, etc.)
# or you can set these as actual environment variables in your deployment.
#

# ----------------------------------------------------------------------------
# API Configuration (api.py)
# ----------------------------------------------------------------------------

# JWT Secret Key - REQUIRED for api.py
# Must be a long, random, secure string (at least 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-to-something-random-and-secure

# Database Connection URL - REQUIRED for api.py
# Format: postgresql://username:password@host:port/database
# Example: postgresql://ajouser:password123@localhost:5432/ajocredit
DATABASE_URL=postgresql://username:password@localhost:5432/ajocredit

# JWT Token Expiry (days) - optional, defaults to 30 days
JWT_EXPIRY_DAYS=30

# ----------------------------------------------------------------------------
# Dash App Configuration (app_dash_web.py)
# ----------------------------------------------------------------------------

# Debug mode - optional, defaults to false
# Set to "true" ONLY in local development
# WARNING: NEVER enable debug mode in production!
DASH_DEBUG=false

# Host - optional, defaults to 127.0.0.1 (localhost)
# Use 0.0.0.0 to allow external connections
DASH_HOST=127.0.0.1

# Port - optional, defaults to 8055
DASH_PORT=8055
